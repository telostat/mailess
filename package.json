    "terser": "^5.44.0",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.36.0",
    "@types/express": "^5.0.3",
    "@types/html-to-text": "^9.0.4",
    "@types/jest": "^30.0.0",
